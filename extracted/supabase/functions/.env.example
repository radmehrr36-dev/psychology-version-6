# کپی کنید به supabase/functions/.env (هرگز commit نشود) و با --env-file به supabase functions serve بدهید.
# توسعه‌ی محلی: کد OTP در ترمینال همین سرور چاپ می‌شود.
APP_ENV=development
OTP_PROVIDER=console
# اختیاری: کلید HMAC برای کدهای OTP (اگر نباشد از service role استفاده می‌شود)
# OTP_PEPPER=
# نام این متغیر باید با service_settings.secret_name (name = 'support-ai') یکی باشد
# SUPPORT_AI_API_KEY=
