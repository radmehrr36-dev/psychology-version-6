# ─────────────────────────────────────────────────────────────
# آریاسازه — نمونه‌ی متغیرهای محیطی
# این فایل را به .env.local کپی کنید و مقادیر واقعی را وارد کنید.
# هرگز .env.local یا کلیدهای واقعی را commit نکنید.
# ─────────────────────────────────────────────────────────────

# اتصال عمومی فرانت‌اند به Supabase (کلید anon / publishable)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# فقط برای اسکریپت bootstrap روی ماشین اپراتور.
# این متغیرها نباید با پیشوند VITE_ باشند و نباید در باندل فرانت‌اند قرار بگیرند.
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
